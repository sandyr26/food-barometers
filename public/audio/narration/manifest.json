  "[\"boy\",\"fr\",\"Serait-il possible pour toi de manger plus de fruits ?\"]": "/audio/narration/boy-2bbb30014cf00bc4e0cc64b8.mp3",
  "[\"boy\",\"fr\",\"Serait-il possible pour toi de manger plus de racines, comme le manioc ou la patate douce par exemple ?\"]": "/audio/narration/boy-8ceed3531f8ee410249b1b52.mp3",
  "[\"boy\",\"fr\",\"Serait-il possible pour toi de manger plus de poissons ?\"]": "/audio/narration/boy-c93b87ee2409ec99c12b5408.mp3",
  "[\"boy\",\"fr\",\"Pour toi, qu’est-ce que ça veut dire « bien manger » ? Dis-le avec tes propres mots.\"]": "/audio/narration/boy-1bb2b56c0fb948f585364e06.mp3",
  "[\"boy\",\"fr\",\"Qu’est-ce que tu veux dire par là ?\"]": "/audio/narration/boy-1da8ee79c46dbd0841e84d6e.mp3",
