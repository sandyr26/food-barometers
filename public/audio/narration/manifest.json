  "[\"boy\",\"fr\",\"« On dit souvent qu’il faut manger moins gras, moins sucré, moins salé, peux-tu me donner un exemple de produit… » Trop gras ?\"]": "/audio/narration/boy-74e31e6617bc75245df7a843.mp3",
  "[\"boy\",\"fr\",\"Trop sucré ?\"]": "/audio/narration/boy-003fa5ed5faa8fa19813350f.mp3",
  "[\"boy\",\"fr\",\"Trop salé ?\"]": "/audio/narration/boy-52d89d444c2b254b7cf9eb84.mp3",
  "[\"boy\",\"fr\",\"Serait-il possible pour toi de manger moins de riz ?\"]": "/audio/narration/boy-dd368389a38a7676dc22aa63.mp3",
  "[\"boy\",\"fr\",\"Serait-il possible pour toi de manger plus de grains ou de légumineuses, comme les lentilles ou les haricots secs par exemple ?\"]": "/audio/narration/boy-1b6f4fde330410fbe686490d.mp3",
  "[\"boy\",\"fr\",\"Serait-il possible pour toi de manger moins de viande ?\"]": "/audio/narration/boy-33edd3145bb96cde36ea221c.mp3",
